[Unit]
Description=CodeMeet 2026 FastAPI Backend Daemon
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/codemeet/backend
ExecStart=/var/www/codemeet/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 4
Restart=always
RestartSec=5
EnvironmentFile=/var/www/codemeet/backend/.env

[Install]
WantedBy=multi-user.target
